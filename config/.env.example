# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитить в git (см. .gitignore).

# --- Почта для отчётов ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Если true — письмо уходит только когда есть изменения/ошибки,
# при "без изменений по всем сайтам" письмо не шлётся.
# Если false (по умолчанию) — письмо с отчётом уходит после каждого прогона.
REPORT_ONLY_ON_CHANGES=false

# --- auth_required сайты (сейчас в sites.yaml таких нет) ---
# Если добавите сайт с access: auth_required и auth_env_prefix: "PREFIX",
# сюда добавляется PREFIX_COOKIES (рекомендуется) либо PREFIX_LOGIN/PREFIX_PASSWORD.
# Пример:
# PREFIX_COOKIES=
